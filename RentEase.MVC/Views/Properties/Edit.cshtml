@using PropertyLeasing.API.Models
@model PropertyLeasing.MVC.ViewModels.EditPropertyViewModel
@using PropertyLeasing.MVC.Helpers
@{
    ViewData["Title"] = "Edit Property";
    ViewData["AmenitiesApplyHint"] = "Applied to every unit in this property.";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fa fa-edit me-2"></i>Edit Property — @Model.Name</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.PropertyId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PropertyId" />
                    <input type="hidden" asp-for="ImgPath" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PropertyType" class="form-label"></label>
                            <select asp-for="PropertyType" class="form-select">
                                <option value="">-- Select --</option>
                                <option>Residential</option>
                                <option>Commercial</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="GracePeriodDays" class="form-label"></label>
                            <input asp-for="GracePeriodDays" class="form-control" type="number" min="0" max="365" />
                            <span asp-validation-for="GracePeriodDays" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LateFeePercent" class="form-label"></label>
                            <input asp-for="LateFeePercent" class="form-control" type="number" min="0" max="100" step="0.01" />
                            <span asp-validation-for="LateFeePercent" class="text-danger small"></span>
                        </div>
                    </div>

                    <partial name="_PropertyAmenitiesEditor" model="Model" />
                    <span asp-validation-for="CustomAmenities" class="text-danger small d-block"></span>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-1"></i> Update
                        </button>
                        <a asp-action="Manage" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@{
    var propImages = ViewBag.PropertyImages as List<PropertyImage> ?? new();
}

<!-- Property Images Card -->
<div class="row justify-content-center mt-4">
    <div class="col-lg-9">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa fa-images me-2 text-primary"></i>Property Images</span>
                <span class="badge bg-secondary">@propImages.Count photos</span>
            </div>
            <div class="card-body">
                @if (propImages.Any())
                {
                    <div class="row g-2 mb-3">
                        @foreach (var img in propImages)
                        {
                            <div class="col-4 col-md-3 position-relative">
                                <img src="@img.ImagePath" class="img-fluid rounded" style="height:100px;width:100%;object-fit:cover;" />
                                <form asp-action="DeletePropertyImage" method="post" class="position-absolute top-0 end-0 m-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="imageId" value="@img.Id" />
                                    <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                                    <button type="submit" class="btn btn-danger btn-sm py-0 px-1"
                                            onclick="return confirm('Delete this image?')"
                                            title="Delete" style="font-size:.7rem;">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3"><i class="fa fa-info-circle me-1"></i>No images uploaded yet.</p>
                }
                <form asp-action="UploadPropertyImages" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="propertyId" value="@Model.PropertyId" />
                    <input type="file" name="files" multiple accept="image/*" class="form-control form-control-sm" style="max-width:340px;" />
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="fa fa-upload me-1"></i>Upload
                    </button>
                </form>
                <div class="form-text mt-1">Supported: JPG, PNG, WEBP. Select multiple files at once.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            document.querySelectorAll('.amenity-fixed-cb').forEach(function (cb) {
                function sync() {
                    var lbl = cb.closest('.amenity-fixed-label');
                    if (!lbl) return;
                    lbl.classList.toggle('btn-primary', cb.checked);
                    lbl.classList.toggle('btn-outline-secondary', !cb.checked);
                    var icon = lbl.querySelector('.amenity-check-icon');
                    if (icon) icon.classList.toggle('invisible', !cb.checked);
                }
                cb.addEventListener('change', sync);
                sync();
            });

            var customListEl = document.getElementById('customAmenitiesList');
            var addBtn = document.getElementById('addCustomAmenity');
            var maxCustom = @PropertyLeasing.BusinessLogic.PropertyAmenitySelection.MaxCustomAmenityItems;
            var maxLen = @PropertyLeasing.BusinessLogic.PropertyAmenitySelection.MaxCustomAmenityItemLength;

            function reindexCustomRows() {
                if (!customListEl) return;
                customListEl.querySelectorAll('.custom-amenity-row input[type=text]').forEach(function (inp, idx) {
                    inp.name = 'CustomAmenities[' + idx + ']';
                });
            }

            function bindRemove(btn) {
                btn.addEventListener('click', function () {
                    var row = btn.closest('.custom-amenity-row');
                    if (row) row.remove();
                    reindexCustomRows();
                });
            }

            if (customListEl) customListEl.querySelectorAll('.remove-custom-amenity').forEach(bindRemove);

            if (addBtn && customListEl) {
                addBtn.addEventListener('click', function () {
                    var count = customListEl.querySelectorAll('.custom-amenity-row').length;
                    if (count >= maxCustom) return;
                    var wrap = document.createElement('div');
                    wrap.className = 'custom-amenity-row input-group input-group-sm';
                    wrap.innerHTML =
                        '<input type="text" class="form-control" maxlength="' + maxLen + '" placeholder="Custom amenity name" />' +
                        '<button type="button" class="btn btn-outline-danger remove-custom-amenity" title="Remove">' +
                        '<i class="fa fa-times"></i></button>';
                    customListEl.appendChild(wrap);
                    bindRemove(wrap.querySelector('.remove-custom-amenity'));
                    reindexCustomRows();
                });
            }
        })();
    </script>
}
