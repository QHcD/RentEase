@model PropertyLeasing.MVC.ViewModels.VerifyResetCodeViewModel
@{
    ViewData["Title"] = "Reset Password";
    var shownCode   = TempData["ResetCode"]  as string;
    bool emailSent  = TempData["EmailSent"] as bool? == true;
}

<div class="row justify-content-center g-4">

    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0"><i class="fa fa-lock-open me-2"></i>Reset Password</h4>
            </div>
            <div class="card-body">

                @if (emailSent)
                {
                    <div class="alert alert-success d-flex align-items-center gap-3 mb-4">
                        <i class="fa fa-envelope-circle-check fa-2x"></i>
                        <div>
                            <div class="fw-semibold mb-1">Check your email!</div>
                            <div class="small">We sent a 6-digit reset code to <strong>@Model.Email</strong></div>
                            <small class="text-muted">This code expires in 15 minutes.</small>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrEmpty(shownCode))
                {
                    <div class="alert alert-warning d-flex align-items-center gap-3 mb-4">
                        <i class="fa fa-exclamation-triangle fa-2x"></i>
                        <div>
                            <div class="fw-semibold mb-1">Email unavailable — here is your code:</div>
                            <div class="fs-3 fw-bold letter-spacing-2">@shownCode</div>
                            <small class="text-muted">This code expires in 15 minutes.</small>
                        </div>
                    </div>
                }

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <input type="hidden" asp-for="Email" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email</label>
                        <input type="text" class="form-control" value="@Model.Email" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label fw-semibold">6-Digit Reset Code</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa fa-hashtag"></i></span>
                            <input asp-for="Code" class="form-control" placeholder="123456"
                                   maxlength="6" inputmode="numeric" autocomplete="one-time-code" />
                        </div>
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa fa-lock"></i></span>
                            <input asp-for="NewPassword" class="form-control" placeholder="At least 6 characters"
                                   autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa fa-lock"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control"
                                   autocomplete="new-password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-success w-100">
                        <i class="fa fa-check me-1"></i> Reset Password
                    </button>
                </form>
            </div>
            <div class="card-footer text-center text-muted small">
                Didn't receive a code? <a asp-action="ForgotPassword">Request a new one</a>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
