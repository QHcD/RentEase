@model PropertyLeasing.MVC.ViewModels.MaintenanceDetailViewModel
@{
    ViewData["Title"] = $"Request — {Model.TicketNumber}";
    var role = ViewBag.Role as string;

    string BadgeColor(string s) => s switch {
        "Submitted"  => "secondary",
        "Assigned"   => "info",
        "InProgress" => "primary",
        "Resolved"   => "success",
        "Closed"     => "dark",
        "Cancelled"  => "danger",
        _            => "secondary"
    };
    string PriorityColor(string p) => p switch {
        "Urgent" => "danger",
        "High"   => "warning",
        "Medium" => "info",
        _        => "secondary"
    };
    string CatIcon(string? t) => t switch {
        "Plumbing"   => "🔧",
        "Electrical" => "⚡",
        "HVAC"       => "❄️",
        "Carpentry"  => "🪚",
        _            => "🔨"
    };

    bool isCancelled = Model.Status == "Cancelled";
    bool canUpdate   = (role == "PropertyManager" || role == "MaintenanceStaff")
                    && Model.Status != "Resolved"
                    && Model.Status != "Closed"
                    && !isCancelled;

    // Pre-tenancy lock: staff cannot resolve before the scheduled date
    bool resolvedLocked = role == "MaintenanceStaff"
                       && Model.ScheduledDate.HasValue
                       && DateTime.Today < Model.ScheduledDate.Value.Date;

    var skillIcons = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Plumbing"]   = "🔧", ["Electrical"] = "⚡", ["HVAC"]      = "❄️",
        ["Carpentry"]  = "🪚", ["General"]    = "🔨"
    };
    string SkillBadges(string? skills)
    {
        if (string.IsNullOrEmpty(skills)) return "";
        return string.Join(" ", skills.Split(',').Select(s => {
            var t = s.Trim();
            return (skillIcons.TryGetValue(t, out var ic) ? ic : "🔧") + " " + t;
        }));
    }
}

<style>
    .res-upload-area {
        border: 2px dashed #198754;
        border-radius: 10px;
        padding: 1.2rem;
        text-align: center;
        cursor: pointer;
        transition: all .2s;
        background: #f0fff4;
        min-height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .res-upload-area:hover, .res-upload-area.dragover { background: #d1fae5; border-color: #0f6a35; }
    .res-upload-area.has-image { padding: .5rem; }

    .staff-card {
        border: 2px solid #dee2e6;
        border-radius: 10px;
        padding: .6rem .9rem;
        cursor: pointer;
        transition: all .15s ease;
        background: #fff;
        margin-bottom: .4rem;
    }
    .staff-card:hover   { border-color: #ffc107; background: #fffbf0; }
    .staff-card.sel     { border-color: #fd7e14; background: #fff3cd;
                          box-shadow: 0 0 0 3px rgba(253,126,20,.2); }
    .s-av {
        width: 32px; height: 32px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: .9rem; flex-shrink: 0;
    }

    .timeline { position: relative; padding-left: 2rem; }
    .timeline::before {
        content: '';
        position: absolute;
        left: .7rem; top: 0; bottom: 0;
        width: 2px;
        background: #dee2e6;
    }
    .timeline-item { position: relative; margin-bottom: 1.25rem; }
    .timeline-dot {
        position: absolute;
        left: -1.65rem; top: .25rem;
        width: 14px; height: 14px;
        border-radius: 50%;
        border: 2px solid #fff;
        box-shadow: 0 0 0 2px #6c757d;
    }
    .info-row { display: flex; gap: .5rem; margin-bottom: .5rem; font-size: .9rem; }
    .info-label { color: #888; min-width: 130px; }
    .info-value { font-weight: 500; }
</style>

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-arrow-left me-1"></i> Back
    </a>
    <h4 class="mb-0 ms-2">
        <i class="fa fa-clipboard-list me-2 text-warning"></i>Request Details
    </h4>
</div>

@* ── Cancelled banner ─────────────────────────────────────────────────────── *@
@if (isCancelled)
{
    <div class="alert alert-danger d-flex align-items-start gap-3 shadow-sm mb-3">
        <i class="fa fa-ban fa-lg mt-1"></i>
        <div>
            <strong>This request has been cancelled</strong>
            @if (!string.IsNullOrEmpty(Model.CancellationReason))
            {
                <div class="mt-1">Reason: <strong>@Model.CancellationReason</strong></div>
            }
        </div>
    </div>
}

@* ── Not-assigned notice for MaintenanceStaff viewing someone else's request ── *@
@if (ViewBag.NotAssigned == true)
{
    var assignedTo = ViewBag.AssignedToName as string;
    <div class="alert alert-warning d-flex align-items-start gap-3 shadow-sm">
        <i class="fa fa-triangle-exclamation fa-lg mt-1 text-warning"></i>
        <div>
            <strong>Access Restricted</strong><br />
            @if (!string.IsNullOrEmpty(assignedTo))
            {
                <span>This request has been assigned to <strong>@assignedTo</strong>. You are not authorised to update it.</span>
            }
            else
            {
                <span>This request has not been assigned to you. You are not authorised to update it.</span>
            }
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex align-items-center gap-2"
             style="background: linear-gradient(135deg,#fd7e14,#ffc107);">
            <span class="fs-2">@CatIcon(Model.RequestType)</span>
            <div>
                <div class="fw-bold text-white fs-5">@Model.Title</div>
                <small class="text-white opacity-75 font-monospace">@Model.TicketNumber</small>
            </div>
            <span class="badge bg-@BadgeColor(Model.Status) ms-auto fs-6">@Model.Status</span>
        </div>
        <div class="card-body">
            <div class="info-row">
                <span class="info-label"><i class="fa fa-building me-1"></i>Property</span>
                <span class="info-value">@Model.PropertyName</span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="fa fa-door-open me-1"></i>Unit</span>
                <span class="info-value">@Model.UnitNumber</span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="fa fa-tag me-1"></i>Category</span>
                <span class="info-value">@(Model.RequestType ?? "—")</span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="fa fa-flag me-1"></i>Priority</span>
                <span class="info-value">
                    <span class="badge bg-@PriorityColor(Model.Priority)">@Model.Priority</span>
                </span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="fa fa-calendar me-1"></i>Submitted</span>
                <span class="info-value">@Model.SubmittedAt.ToString("dd MMMM yyyy, hh:mm tt")</span>
            </div>
        </div>
    </div>
}
else
{

<div class="row g-4">

    <!-- LEFT: Request Info -->
    <div class="col-lg-@(canUpdate ? "5" : "7")">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex align-items-center gap-2"
                 style="background: linear-gradient(135deg,#fd7e14,#ffc107);">
                <span class="fs-2">@CatIcon(Model.RequestType)</span>
                <div>
                    <div class="fw-bold text-white fs-5">@Model.Title</div>
                    <small class="text-white opacity-75 font-monospace">@Model.TicketNumber</small>
                </div>
                <span class="badge bg-@BadgeColor(Model.Status) ms-auto fs-6">@Model.Status</span>
            </div>
            <div class="card-body">

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="alert alert-light border mb-3">
                        <i class="fa fa-quote-left me-2 text-warning"></i>@Model.Description
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div class="mb-3">
                        <div class="fw-semibold small text-muted mb-1">
                            <i class="fa fa-camera me-1"></i> Attached Photo
                        </div>
                        <a href="@Model.ImagePath" target="_blank">
                            <img src="@Model.ImagePath" alt="Maintenance photo"
                                 class="img-fluid rounded border"
                                 style="max-height:260px; object-fit:cover; cursor:zoom-in;" />
                        </a>
                        <div class="small text-muted mt-1">Click to view full size</div>
                    </div>
                }

                <div class="info-row">
                    <span class="info-label"><i class="fa fa-building me-1"></i>Property</span>
                    <span class="info-value">@Model.PropertyName</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="fa fa-door-open me-1"></i>Unit</span>
                    <span class="info-value">@Model.UnitNumber</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="fa fa-user me-1"></i>Tenant</span>
                    <span class="info-value">
                        @Model.TenantName
                        @if (!string.IsNullOrEmpty(Model.TenantEmail) && role == "PropertyManager")
                        {
                            <small class="text-muted ms-1">(@Model.TenantEmail)</small>
                        }
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="fa fa-tag me-1"></i>Category</span>
                    <span class="info-value">@(Model.RequestType ?? "—")</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="fa fa-flag me-1"></i>Priority</span>
                    <span class="info-value">
                        <span class="badge bg-@PriorityColor(Model.Priority)">@Model.Priority</span>
                    </span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="fa fa-user-gear me-1"></i>Assigned To</span>
                    <span class="info-value">@(Model.AssignedStaff ?? "Not assigned")</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="fa fa-calendar me-1"></i>Submitted</span>
                    <span class="info-value">@Model.SubmittedAt.ToString("dd MMMM yyyy, hh:mm tt")</span>
                </div>
                @if (Model.ScheduledDate.HasValue)
                {
                    <div class="info-row">
                        <span class="info-label"><i class="fa fa-calendar-check me-1 text-warning"></i>Scheduled</span>
                        <span class="info-value text-warning fw-semibold">@Model.ScheduledDate.Value.ToString("dd MMMM yyyy")</span>
                    </div>
                }
                @if (Model.ResolvedAt.HasValue)
                {
                    <div class="info-row">
                        <span class="info-label"><i class="fa fa-check-circle me-1 text-success"></i>Resolved</span>
                        <span class="info-value text-success">@Model.ResolvedAt.Value.ToString("dd MMMM yyyy, hh:mm tt")</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ResolutionNotes))
                {
                    <div class="info-row">
                        <span class="info-label"><i class="fa fa-note-sticky me-1"></i>Resolution</span>
                        <span class="info-value">@Model.ResolutionNotes</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.CancellationReason))
                {
                    <div class="info-row">
                        <span class="info-label"><i class="fa fa-ban me-1 text-danger"></i>Cancelled</span>
                        <span class="info-value text-danger">@Model.CancellationReason</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.ResolutionImagePath))
                {
                    <hr class="my-3" />
                    <div class="mb-2">
                        <div class="fw-semibold small mb-2" style="color:#198754;">
                            <i class="fa fa-shield-check me-1"></i>Proof of Resolution
                            <span class="badge bg-success ms-1" style="font-size:.65rem;">Verified</span>
                        </div>
                        <a href="@Model.ResolutionImagePath" target="_blank">
                            <img src="@Model.ResolutionImagePath" alt="Resolution proof photo"
                                 class="img-fluid rounded border border-success"
                                 style="max-height:260px; object-fit:cover; cursor:zoom-in;
                                        box-shadow:0 0 0 2px #19875440;" />
                        </a>
                        <div class="small text-muted mt-1">
                            <i class="fa fa-camera me-1"></i>Attached by maintenance staff · Click to view full size
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- RIGHT: Update form (Manager / Staff) + History -->
    <div class="col-lg-@(canUpdate ? "7" : "5") d-flex flex-column gap-4">


        <!-- Status History Timeline -->
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h6 class="mb-0"><i class="fa fa-clock-rotate-left me-2 text-secondary"></i>Status History</h6>
            </div>
            <div class="card-body pb-2">
                @if (!Model.History.Any())
                {
                    <div class="text-muted small text-center py-2">No history yet.</div>
                }
                else
                {
                    <div class="timeline">
                        @foreach (var h in Model.History)
                        {
                            var dotColor = h.NewStatus switch
                            {
                                "Submitted"  => "#6c757d",
                                "Assigned"   => "#0dcaf0",
                                "InProgress" => "#0d6efd",
                                "Resolved"   => "#198754",
                                "Closed"     => "#212529",
                                "Cancelled"  => "#dc3545",
                                _            => "#adb5bd"
                            };
                            <div class="timeline-item">
                                <div class="timeline-dot" style="background:@dotColor; box-shadow:0 0 0 2px @dotColor;"></div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    @if (!string.IsNullOrEmpty(h.OldStatus))
                                    {
                                        <span class="badge bg-secondary bg-opacity-50 text-dark">@h.OldStatus</span>
                                        <i class="fa fa-arrow-right text-muted small"></i>
                                    }
                                    <span class="badge" style="background:@dotColor">@h.NewStatus</span>
                                </div>
                                @if (!string.IsNullOrEmpty(h.Notes))
                                {
                                    <div class="small text-secondary fst-italic mb-1">"@h.Notes"</div>
                                }
                                <div class="small text-muted">
                                    <i class="fa fa-user me-1"></i>@h.ChangedByName
                                    <span class="ms-2">
                                        <i class="fa fa-clock me-1"></i>@h.ChangedAt.ToString("dd MMM yyyy, hh:mm tt")
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>


        @* ── Update form — only when request is still actionable ── *@
        @if (role == "PropertyManager" || role == "MaintenanceStaff")
        {
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h6 class="mb-0"><i class="fa fa-edit me-2"></i>Update Request</h6>
                </div>
                <div class="card-body p-4">

                    @if (isCancelled)
                    {
                        <div class="alert alert-danger mb-0">
                            <i class="fa fa-ban me-2"></i>
                            This request has been <strong>Cancelled</strong> and cannot be modified.
                            @if (!string.IsNullOrEmpty(Model.CancellationReason))
                            {
                                <div class="small mt-1">Reason: <strong>@Model.CancellationReason</strong></div>
                            }
                        </div>
                    }
                    else if (Model.Status == "Resolved" || Model.Status == "Closed")
                    {
                        <div class="alert alert-success mb-0">
                            <i class="fa fa-lock me-2"></i>
                            This request is already <strong>@Model.Status</strong> and cannot be modified.
                            @if (Model.ResolvedAt.HasValue)
                            {
                                <div class="small mt-1 text-muted">
                                    <i class="fa fa-check-circle text-success me-1"></i>
                                    Resolved on @Model.ResolvedAt.Value.ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <form asp-action="Update" method="post" enctype="multipart/form-data"
                              onsubmit="return validateManagerAssignment(event)">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="RequestId"     value="@Model.RequestId" />
                            <input type="hidden" name="Title"         value="@Model.Title" />
                            <input type="hidden" name="CurrentStatus" value="@Model.Status" />
                            <input type="hidden" name="NewStatus"     id="newStatusInput" value="@Model.Status" />

                            @* Current status badge *@
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Current Status</label>
                                <div>
                                    <span class="badge bg-@BadgeColor(Model.Status) px-3 py-2 fs-6">@Model.Status</span>
                                </div>
                            </div>

                            @* ── Staff Assignment (Manager only) ── *@
                            @if (role == "PropertyManager")
                            {
                                <div class="mb-4">
                                    <label class="form-label fw-semibold">
                                        <i class="fa fa-user-gear me-1 text-warning"></i>Assign to Staff
                                    </label>
                                    <input type="hidden" name="AssignedStaffId" id="assignedStaffIdInput"
                                           value="@(Model.AssignedStaffId?.ToString() ?? "")" />

                                    @if (ViewBag.StaffFilterRelaxed == true)
                                    {
                                        <div class="alert alert-warning py-2 small mb-2">
                                            <i class="fa fa-info-circle me-1"></i>
                                            No <strong>@Model.RequestType</strong> specialists were found.
                                            Showing other available staff so you can still assign someone.
                                        </div>
                                    }
                                    @if (Model.StaffList.Any())
                                    {
                                        @foreach (var s in Model.StaffList)
                                        {
                                            var avail      = s.AvailabilityStatus ?? "Available";
                                            var aColor     = avail == "Available" ? "success" : avail == "Busy" ? "warning" : "secondary";
                                            var isSel      = s.UserId == Model.AssignedStaffId;
                                            <div class="staff-card @(isSel ? "sel" : "")"
                                                 onclick="selStaff(this, '@s.UserId')">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="s-av bg-@aColor text-white">
                                                        @(s.FullName.Length > 0 ? s.FullName[0].ToString().ToUpper() : "?")
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <div class="fw-semibold small">@s.FullName</div>
                                                        @if (!string.IsNullOrEmpty(s.SkillProfile))
                                                        {
                                                            <div class="small text-muted" style="font-size:.72rem;">
                                                                @SkillBadges(s.SkillProfile)
                                                            </div>
                                                        }
                                                    </div>
                                                    <span class="badge bg-@aColor">@avail</span>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-muted small">No maintenance staff available.</div>
                                    }
                                </div>
                            }

                            @* ── Notes ── *@
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    <i class="fa fa-note-sticky me-1 text-warning"></i>Notes / Resolution
                                </label>
                                <textarea name="Notes" class="form-control" rows="4"
                                          placeholder="Describe the action taken or reason for this status change..."></textarea>
                            </div>

                            @* ── Resolution proof photo — shown when staff clicks Resolved ── *@
                            <div id="resolutionProofSection" class="mb-3 d-none">
                                <label class="form-label fw-semibold">
                                    <i class="fa fa-camera me-1 text-success"></i>
                                    Proof of Resolution Photo
                                    <span class="badge bg-success ms-1 small">Recommended</span>
                                </label>
                                <div id="resUploadArea" class="res-upload-area"
                                     onclick="document.getElementById('resImageInput').click()"
                                     ondragover="event.preventDefault(); this.classList.add('dragover')"
                                     ondragleave="this.classList.remove('dragover')"
                                     ondrop="handleResDrop(event)">
                                    <div id="resUploadPlaceholder">
                                        <i class="fa fa-cloud-upload-alt fa-2x text-muted mb-1"></i>
                                        <div class="text-muted small">Upload photo as proof the issue is fixed</div>
                                        <div class="text-muted" style="font-size:.72rem;">JPG, PNG, WEBP — max 5 MB</div>
                                    </div>
                                    <img id="resImagePreview" src="#" alt="Resolution proof"
                                         class="d-none rounded"
                                         style="max-height:160px; max-width:100%; object-fit:cover;" />
                                </div>
                                <input type="file" id="resImageInput" name="ResolutionImageFile"
                                       accept="image/jpeg,image/png,image/webp,image/gif"
                                       class="d-none" onchange="previewResImage(this)" />
                                <div id="resFileName" class="small text-muted mt-1"></div>
                                <button type="button" id="removeResBtn"
                                        class="btn btn-outline-danger btn-sm mt-1 d-none"
                                        onclick="removeResImage()">
                                    <i class="fa fa-times me-1"></i>Remove
                                </button>
                            </div>

                            @* ── Action buttons ── *@
                            @if (role == "MaintenanceStaff")
                            {
                                <div class="d-flex gap-3 mt-4">
                                    @if (Model.Status == "Assigned")
                                    {
                                        <button type="submit" class="btn btn-primary btn-lg flex-fill"
                                                onclick="document.getElementById('newStatusInput').value='InProgress'">
                                            <i class="fa fa-play me-2"></i>In Progress
                                        </button>
                                    }
                                    else if (Model.Status == "InProgress")
                                    {
                                        if (resolvedLocked)
                                        {
                                            <div class="w-100">
                                                <button type="button" class="btn btn-success btn-lg flex-fill w-100" disabled>
                                                    <i class="fa fa-lock me-2"></i>Resolved
                                                </button>
                                                <div class="alert alert-warning mt-2 mb-0 py-2 px-3 small">
                                                    <i class="fa fa-clock me-1"></i>
                                                    <strong>Available from @Model.ScheduledDate!.Value.ToString("dd MMM yyyy")</strong>
                                                    — this pre-tenancy request cannot be resolved before the scheduled work date.
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-success btn-lg flex-fill"
                                                    onclick="showResProof(); document.getElementById('newStatusInput').value='Resolved'">
                                                <i class="fa fa-check me-2"></i>Resolved
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <div class="alert alert-info w-100 mb-0">
                                            No action available for status <strong>@Model.Status</strong>.
                                        </div>
                                    }
                                </div>
                            }
                            else @* PropertyManager *@
                            {
                                <div class="d-flex gap-3 mt-4">
                                    <button type="submit" class="btn btn-dark btn-lg flex-fill">
                                        <i class="fa fa-user-check me-2"></i>Save Assignment
                                    </button>
                                </div>
                            }
                        </form>
                    }
                </div>
            </div>
        }

    </div>
</div>

} @* end else (normal view for assigned staff / manager / tenant) *@

@section Scripts {
<script>
    const isManagerAssigning = @(role == "PropertyManager" && Model.Status == "Submitted" && !Model.AssignedStaffId.HasValue ? "true" : "false");

    function validateManagerAssignment(e) {
        if (!isManagerAssigning) return true;
        const staffId = document.getElementById('assignedStaffIdInput')?.value?.trim();
        if (!staffId) {
            e.preventDefault();
            alert('Please select a maintenance staff member before saving.');
            return false;
        }
        return true;
    }

    function selStaff(el, userId) {
        document.querySelectorAll('.staff-card').forEach(c => c.classList.remove('sel'));
        el.classList.add('sel');
        document.getElementById('assignedStaffIdInput').value = userId;
    }

    function showResProof() {
        const section = document.getElementById('resolutionProofSection');
        if (section) section.classList.remove('d-none');
    }

    function previewResImage(input) {
        if (input.files && input.files[0]) {
            const file = input.files[0];
            if (file.size > 5 * 1024 * 1024) {
                alert('Image too large. Max 5 MB.');
                input.value = '';
                return;
            }
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('resUploadPlaceholder').classList.add('d-none');
                const preview = document.getElementById('resImagePreview');
                preview.src = e.target.result;
                preview.classList.remove('d-none');
                document.getElementById('resUploadArea').classList.add('has-image');
                document.getElementById('resFileName').textContent = '📎 ' + file.name;
                document.getElementById('removeResBtn').classList.remove('d-none');
            };
            reader.readAsDataURL(file);
        }
    }

    function handleResDrop(e) {
        e.preventDefault();
        document.getElementById('resUploadArea').classList.remove('dragover');
        const dt = e.dataTransfer;
        if (dt.files && dt.files.length > 0) {
            const input = document.getElementById('resImageInput');
            const transfer = new DataTransfer();
            transfer.items.add(dt.files[0]);
            input.files = transfer.files;
            previewResImage(input);
        }
    }

    function removeResImage() {
        const input = document.getElementById('resImageInput');
        if (!input) return;
        input.value = '';
        const preview = document.getElementById('resImagePreview');
        if (preview) { preview.classList.add('d-none'); preview.src = '#'; }
        const ph = document.getElementById('resUploadPlaceholder');
        if (ph) ph.classList.remove('d-none');
        const area = document.getElementById('resUploadArea');
        if (area) area.classList.remove('has-image');
        const fn = document.getElementById('resFileName');
        if (fn) fn.textContent = '';
        const btn = document.getElementById('removeResBtn');
        if (btn) btn.classList.add('d-none');
    }

    // On load: if status is InProgress (staff about to resolve), pre-open proof section
    document.addEventListener('DOMContentLoaded', () => {
        const statusVal = document.getElementById('newStatusInput')?.value;
        if (statusVal === 'InProgress') {
            showResProof();
        }
    });
</script>
}
