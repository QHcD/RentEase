@model PropertyLeasing.MVC.ViewModels.UpdateMaintenanceViewModel
@{
    ViewData["Title"] = "Update Request";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="fa fa-edit me-2"></i>Update — @Model.Title</h5>
                <small>Current status: <span class="badge bg-info">@Model.CurrentStatus</span></small>
            </div>
            <div class="card-body">
                <form asp-action="Update" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="RequestId" type="hidden" />
                    <input asp-for="Title" type="hidden" />
                    <input asp-for="CurrentStatus" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="NewStatus" class="form-label">New Status</label>
                        <select asp-for="NewStatus" class="form-select">
                            <option value="Submitted">Submitted</option>
                            <option value="Assigned">Assigned</option>
                            <option value="InProgress">In Progress</option>
                            <option value="Resolved">Resolved</option>
                            <option value="Closed">Closed</option>
                        </select>
                    </div>

                    @if (User.IsInRole("PropertyManager"))
                    {
                        <div class="mb-3">
                            <label asp-for="AssignedStaffId" class="form-label">Assign to Staff</label>
                            <select asp-for="AssignedStaffId" class="form-select"
                                    asp-items="@(new SelectList(Model.StaffList, "UserId", "FullName"))">
                                <option value="">-- Not assigned --</option>
                            </select>
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label">Notes / Resolution</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  placeholder="Add notes about this update..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            <i class="fa fa-save me-1"></i> Save Update
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
