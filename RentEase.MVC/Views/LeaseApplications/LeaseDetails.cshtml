@model PropertyLeasing.MVC.ViewModels.LeaseListViewModel
@{
    ViewData["Title"] = $"Lease #{Model.LeaseId}";
    var badgeColor = Model.Status switch
    {
        "Active"     => "success",
        "Renewed"    => "primary",
        "Expired"    => "secondary",
        "Terminated" => "danger",
        _            => "secondary"
    };
    bool isOverdue = Model.LeaseEndDate < DateTime.Today && Model.Status == "Active";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa fa-key me-2"></i>Lease #@Model.LeaseId</h2>
    <a asp-action="Index" asp-route-tab="leases" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-arrow-left me-1"></i>Back to List
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (isOverdue)
{
    <div class="alert alert-warning">
        <i class="fa fa-exclamation-triangle me-2"></i>
        This lease passed its end date and is still marked <strong>Active</strong>.
    </div>
}

<div class="row g-4">

    <!-- Lease Info -->
    <div class="col-md-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <span><i class="fa fa-file-contract me-2"></i>Lease Details</span>
                <span class="badge bg-light text-dark fs-6">@Model.Status</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Property</dt>
                    <dd class="col-sm-8">@Model.PropertyName</dd>

                    <dt class="col-sm-4">Unit</dt>
                    <dd class="col-sm-8">@Model.UnitNumber</dd>

                    <dt class="col-sm-4">Start Date</dt>
                    <dd class="col-sm-8">@Model.LeaseStartDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4">End Date</dt>
                    <dd class="col-sm-8">
                        @Model.LeaseEndDate.ToString("dd MMM yyyy")
                        @if (isOverdue)
                        {
                            <span class="badge bg-warning text-dark ms-1">Overdue</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Monthly Rent</dt>
                    <dd class="col-sm-8">
                        <strong class="text-success fs-5">BD @Model.MonthlyRent.ToString("N2")</strong>
                    </dd>

                    <dt class="col-sm-4">Security Deposit</dt>
                    <dd class="col-sm-8">BD @Model.SecurityDeposit.ToString("N2")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-@badgeColor fs-6">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Tenant Info (manager only) -->
    @if (User.IsInRole("PropertyManager"))
    {
        <div class="col-md-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-secondary text-white">
                    <i class="fa fa-user me-2"></i>Tenant
                </div>
                <div class="card-body d-flex align-items-center">
                    <div>
                        <p class="mb-0 fs-5 fw-semibold">@Model.TenantName</p>
                        <a asp-action="Index"
                           asp-route-tab="applications"
                           asp-route-appStatus="Approved"
                           class="btn btn-outline-primary btn-sm mt-2">
                            <i class="fa fa-file-alt me-1"></i>View Applications
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Status History -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <i class="fa fa-history me-2"></i>Status History
            </div>
            @if (Model.Logs.Any())
            {
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var log in Model.Logs)
                        {
                            var logBadge = log.Status switch
                            {
                                "Active"     => "success",
                                "Renewed"    => "primary",
                                "Expired"    => "secondary",
                                "Terminated" => "danger",
                                _            => "secondary"
                            };
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="badge bg-@logBadge me-2">@log.Status</span>
                                    <small class="text-muted">by @log.ChangedByUserName</small>
                                    @if (!string.IsNullOrWhiteSpace(log.Notes))
                                    {
                                        <p class="mb-0 mt-1 small text-muted fst-italic">@log.Notes</p>
                                    }
                                </div>
                                <small class="text-muted text-nowrap ms-3">
                                    @log.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                </small>
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="card-body text-muted">No status history recorded.</div>
            }
        </div>
    </div>

</div>
