@model PropertyLeasing.MVC.ViewModels.LeaseListViewModel
@{
    ViewData["Title"] = $"Lease #{Model.LeaseId}";
    var badgeColor = Model.Status switch
    {
        "Active"     => "success",
        "Renewed"    => "primary",
        "Expired"    => "secondary",
        "Terminated" => "danger",
        _            => "secondary"
    };
    bool isLeaseOverdue = Model.LeaseEndDate < DateTime.Today && Model.Status == "Active";

    string PayBadge(string s) => s switch
    {
        "Paid"     => "success",
        "Overdue"  => "danger",
        "Unpaid"   => "warning",
        "Upcoming" => "info",
        _          => "secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa fa-key me-2"></i>Lease #@Model.LeaseId</h2>
    <a asp-action="Index" asp-route-tab="leases" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-arrow-left me-1"></i>Back to List
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (isLeaseOverdue)
{
    <div class="alert alert-warning">
        <i class="fa fa-exclamation-triangle me-2"></i>
        This lease passed its end date and is still marked <strong>Active</strong>.
    </div>
}

<div class="row g-4">

    <!-- Lease Info -->
    <div class="col-md-7">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <span><i class="fa fa-file-contract me-2"></i>Lease Details</span>
                <span class="badge bg-light text-dark fs-6">@Model.Status</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Property</dt>
                    <dd class="col-sm-8">@Model.PropertyName</dd>

                    <dt class="col-sm-4">Unit</dt>
                    <dd class="col-sm-8">@Model.UnitNumber</dd>

                    <dt class="col-sm-4">Start Date</dt>
                    <dd class="col-sm-8">@Model.LeaseStartDate.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4">End Date</dt>
                    <dd class="col-sm-8">
                        @Model.LeaseEndDate.ToString("dd MMM yyyy")
                        @if (isLeaseOverdue)
                        {
                            <span class="badge bg-warning text-dark ms-1">Overdue</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Monthly Rent</dt>
                    <dd class="col-sm-8">
                        <strong class="text-success fs-5">BD @Model.MonthlyRent.ToString("N2")</strong>
                    </dd>

                    <dt class="col-sm-4">Security Deposit</dt>
                    <dd class="col-sm-8">BD @Model.SecurityDeposit.ToString("N2")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-@badgeColor fs-6">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Tenant Info (manager only) -->
    @if (User.IsInRole("PropertyManager"))
    {
        <div class="col-md-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-secondary text-white">
                    <i class="fa fa-user me-2"></i>Tenant
                </div>
                <div class="card-body d-flex align-items-center">
                    <div>
                        <p class="mb-0 fs-5 fw-semibold">@Model.TenantName</p>
                        <a asp-action="Index"
                           asp-route-tab="applications"
                           asp-route-appStatus="Approved"
                           class="btn btn-outline-primary btn-sm mt-2">
                            <i class="fa fa-file-alt me-1"></i>View Applications
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Payment Records -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span><i class="fa fa-money-bill-wave me-2"></i>Payment Schedule</span>
                <small class="text-muted">
                    Grace Period: <strong>@Model.GracePeriodDays days</strong>
                    &nbsp;|&nbsp; Late Fee: <strong>@Model.LateFeePercent%</strong> of installment
                </small>
            </div>
            @if (!Model.Payments.Any())
            {
                <div class="card-body text-muted">No payment records found.</div>
            }
            else
            {
                var paidCount    = Model.Payments.Count(p => p.Status == "Paid");
                var overdueCount = Model.Payments.Count(p => p.Status == "Overdue");
                var unpaidCount  = Model.Payments.Count(p => p.Status == "Unpaid");
                <div class="card-body pb-0">
                    <div class="d-flex gap-3 mb-3 flex-wrap">
                        <span class="badge bg-success fs-6">Paid: @paidCount</span>
                        <span class="badge bg-warning text-dark fs-6">Unpaid: @unpaidCount</span>
                        <span class="badge bg-danger fs-6">Overdue: @overdueCount</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">#</th>
                                <th>Due Date</th>
                                <th>Amount Due</th>
                                <th>Late Fee</th>
                                <th>Total</th>
                                <th>Amount Paid</th>
                                <th>Paid On</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Payments)
                            {
                                var rowCls = p.Status == "Overdue" ? "table-danger"
                                           : p.Status == "Paid"    ? "table-success"
                                           : "";
                                decimal total = p.AmountDue + (p.LateFee ?? 0);
                                <tr class="@rowCls">
                                    <td class="ps-3 text-muted small">@p.InstallmentNum / @p.TotalInstallments</td>
                                    <td>@p.DueDate.ToString("dd MMM yyyy")</td>
                                    <td>BD @p.AmountDue.ToString("N2")</td>
                                    <td>
                                        @if (p.LateFee.HasValue && p.LateFee > 0)
                                        {
                                            <span class="text-danger fw-semibold">BD @p.LateFee.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="fw-semibold">BD @total.ToString("N2")</td>
                                    <td>
                                        @if (p.AmountPaid.HasValue)
                                        {
                                            <span>BD @p.AmountPaid.Value.ToString("N2")</span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td class="text-muted small">
                                        @(p.PaidDate?.ToString("dd MMM yyyy") ?? "—")
                                    </td>
                                    <td>
                                        <span class="badge bg-@PayBadge(p.Status)">@p.Status</span>
                                    </td>
                                    <td class="text-muted small">@(p.Notes ?? "—")</td>
                                    <td>
                                    @if (!User.IsInRole("PropertyManager"))
                                    {
                                        @if (p.Status == "Paid")
                                        {
                                            <span class="text-success small"><i class="fa fa-check-circle me-1"></i>Paid</span>
                                        }
                                        else if (p.Status == "Upcoming")
                                        {
                                            <span class="text-muted small"><i class="fa fa-clock me-1"></i>@p.DueDate.ToString("dd MMM yyyy")</span>
                                        }
                                        else if (p.Status == "Unpaid" || p.Status == "Overdue")
                                        {
                                            <a asp-controller="Payments" asp-action="Pay"
                                               asp-route-paymentId="@p.PaymentId"
                                               class="btn btn-sm @(p.Status == "Overdue" ? "btn-danger" : "btn-warning")">
                                                <i class="fa fa-credit-card me-1"></i>Pay
                                            </a>
                                        }
                                    }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Status History -->
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <i class="fa fa-history me-2"></i>Status History
            </div>
            @if (Model.Logs.Any())
            {
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var log in Model.Logs)
                        {
                            var logBadge = log.Status switch
                            {
                                "Active"     => "success",
                                "Renewed"    => "primary",
                                "Expired"    => "secondary",
                                "Terminated" => "danger",
                                _            => "secondary"
                            };
                            <li class="list-group-item d-flex justify-content-between align-items-start">
                                <div>
                                    <span class="badge bg-@logBadge me-2">@log.Status</span>
                                    <small class="text-muted">by @log.ChangedByUserName</small>
                                    @if (!string.IsNullOrWhiteSpace(log.Notes))
                                    {
                                        <p class="mb-0 mt-1 small text-muted fst-italic">@log.Notes</p>
                                    }
                                </div>
                                <small class="text-muted text-nowrap ms-3">
                                    @log.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                </small>
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="card-body text-muted">No status history recorded.</div>
            }
        </div>
    </div>

</div>
