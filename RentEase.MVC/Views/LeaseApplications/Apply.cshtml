@model PropertyLeasing.MVC.ViewModels.CreateLeaseApplicationViewModel
@{
    ViewData["Title"] = "Apply for Lease";
    var minStart = DateTime.Today.AddDays(2).ToString("yyyy-MM-dd");
    var maxStart = DateTime.Today.AddMonths(2).ToString("yyyy-MM-dd");
    var defaultStart = DateTime.Today.AddDays(2).ToString("yyyy-MM-dd");
    var maxEnd = DateTime.Today.AddDays(2).AddYears(1).ToString("yyyy-MM-dd");
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0"><i class="fa fa-file-alt me-2"></i>Lease Application</h4>
            </div>
            <div class="card-body">

                <!-- Unit summary -->
                <div class="alert alert-info mb-4">
                    <strong>Unit:</strong> @Model.UnitNumber &nbsp;|&nbsp;
                    <strong>Property:</strong> @Model.PropertyName &nbsp;|&nbsp;
                    <strong>Rent:</strong> BD @Model.MonthlyRent?.ToString("N0") /month
                </div>

                <form asp-action="Apply" method="post" id="applyForm" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input asp-for="UnitId"       type="hidden" />
                    <input asp-for="UnitNumber"   type="hidden" />
                    <input asp-for="PropertyName" type="hidden" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="RequestedStartDate" class="form-label fw-semibold"></label>
                            <input asp-for="RequestedStartDate"
                                   type="date"
                                   class="form-control"
                                   id="startDate"
                                   min="@minStart"
                                   max="@maxStart"
                                   value="@defaultStart" />
                            <div class="form-text text-muted">
                                Between <strong>@DateTime.Today.AddDays(2).ToString("dd MMM yyyy")</strong>
                                and <strong>@DateTime.Today.AddMonths(2).ToString("dd MMM yyyy")</strong>
                            </div>
                            <span asp-validation-for="RequestedStartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RequestedEndDate" class="form-label fw-semibold"></label>
                            <input asp-for="RequestedEndDate"
                                   type="date"
                                   class="form-control"
                                   id="endDate"
                                   min="@minStart"
                                   max="@maxEnd" />
                            <div class="form-text text-muted" id="endDateHint">
                                Maximum 1 year from start date.
                            </div>
                            <span asp-validation-for="RequestedEndDate" class="text-danger small"></span>
                            <div id="endDateError" class="text-danger small d-none"></div>
                        </div>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2"></div>

                    <div class="mb-4 p-3 border rounded bg-light">
                        <h6 class="fw-semibold mb-3">
                            <i class="fa fa-file-upload me-2 text-success"></i>Required Documents
                        </h6>
                        <p class="small text-muted mb-3">
                            Upload clear PDF copies of your ID and proof of income (max 10 MB each).
                        </p>
                        <div class="mb-3">
                            <label asp-for="NationalIdFile" class="form-label fw-semibold"></label>
                            <input asp-for="NationalIdFile" type="file" class="form-control" accept=".pdf,application/pdf" required />
                            <span asp-validation-for="NationalIdFile" class="text-danger small"></span>
                        </div>
                        <div class="mb-0">
                            <label asp-for="SalaryIncomeFile" class="form-label fw-semibold"></label>
                            <input asp-for="SalaryIncomeFile" type="file" class="form-control" accept=".pdf,application/pdf" required />
                            <span asp-validation-for="SalaryIncomeFile" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  placeholder="Any special requirements or notes..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success flex-fill" id="submitBtn">
                            <i class="fa fa-paper-plane me-1"></i> Submit Application
                        </button>
                        <a asp-controller="Properties" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        (function () {
            const startInput = document.getElementById('startDate');
            const endInput   = document.getElementById('endDate');
            const endHint    = document.getElementById('endDateHint');
            const endError   = document.getElementById('endDateError');

            function updateEndConstraints() {
                const startVal = startInput.value;
                if (!startVal) return;

                const startDate = new Date(startVal);
                const maxEndDate = new Date(startDate);
                maxEndDate.setFullYear(maxEndDate.getFullYear() + 1);

                const minEndDate = new Date(startDate);
                minEndDate.setDate(minEndDate.getDate() + 1);

                const fmt = d => d.toISOString().split('T')[0];

                endInput.min = fmt(minEndDate);
                endInput.max = fmt(maxEndDate);

                // Update hint text
                const displayFmt = d => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
                endHint.textContent = `Maximum end date: ${displayFmt(maxEndDate)}`;

                // Validate end date if already filled
                if (endInput.value) {
                    const endDate = new Date(endInput.value);
                    if (endDate > maxEndDate) {
                        endInput.value = fmt(maxEndDate);
                    }
                    if (endDate <= startDate) {
                        endInput.value = fmt(minEndDate);
                    }
                }
            }

            function validateForm(e) {
                const startDate = new Date(startInput.value);
                const endDate   = new Date(endInput.value);
                const today     = new Date();
                today.setHours(0, 0, 0, 0);

                const minStart = new Date(today);
                minStart.setDate(minStart.getDate() + 2);

                const maxStart = new Date(today);
                maxStart.setMonth(maxStart.getMonth() + 2);

                const maxEnd = new Date(startDate);
                maxEnd.setFullYear(maxEnd.getFullYear() + 1);

                let valid = true;
                endError.classList.add('d-none');
                endError.textContent = '';

                if (!endInput.value) {
                    endError.textContent = 'End date is required.';
                    endError.classList.remove('d-none');
                    valid = false;
                } else if (endDate <= startDate) {
                    endError.textContent = 'End date must be after the start date.';
                    endError.classList.remove('d-none');
                    valid = false;
                } else if (endDate > maxEnd) {
                    endError.textContent = 'Lease period cannot exceed one year from the start date.';
                    endError.classList.remove('d-none');
                    valid = false;
                }

                if (!valid) e.preventDefault();
            }

            startInput.addEventListener('change', updateEndConstraints);
            document.getElementById('applyForm').addEventListener('submit', validateForm);

            // Initialise on page load
            updateEndConstraints();
        })();
    </script>
}
