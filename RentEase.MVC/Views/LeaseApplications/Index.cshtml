@model PropertyLeasing.MVC.ViewModels.ApplicationsAndLeasesViewModel
@{
    ViewData["Title"] = Model.IsManager ? "Applications & Leases" : "My Applications & Leases";

    string AppBadge(string s) => s switch
    {
        "Approved"  => "success",
        "Rejected"  => "danger",
        "Screening" => "info",
        "Pending"   => "warning",
        "Canceled"  => "secondary",
        _           => "secondary"
    };
    string LeaseBadge(string s) => s switch
    {
        "Active"         => "success",
        "Renewed"        => "primary",
        "Approved"       => "info",
        "Terminated"     => "danger",
        "PendingPayment" => "warning",
        _                => "secondary"
    };

    string AppUrl(string status)   => $"?tab=applications&appStatus={status}&leaseStatus={Model.LeaseStatusFilter}";
    string LeaseUrl(string status) => $"?tab=leases&appStatus={Model.AppStatusFilter}&leaseStatus={status}";

    int appRowCount   = Model.IsManager
        ? Model.ApplicationGroups.Sum(g => g.ApplicationCount)
        : Model.Applications.Count;
    int leaseRowCount = Model.Leases.Count;
}

<!-- Cancel Application Modal (shared) -->
<div class="modal fade" id="cancelAppModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title"><i class="fa fa-times-circle me-2"></i>Cancel Application</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to cancel this application? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep It</button>
                <form id="cancelAppForm" method="post" asp-action="CancelApplication">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="cancelAppId" name="applicationId" value="" />
                    <input type="hidden" name="returnTo" value="Index" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fa fa-times me-1"></i>Cancel Application
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa fa-file-contract me-2"></i>@ViewData["Title"]</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- ══ MAIN TABS ═══════════════════════════════════════════════════════════ -->
<ul class="nav nav-tabs" id="mainTabs">
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "applications" ? "active fw-semibold" : "")"
           href="?tab=applications&appStatus=@Model.AppStatusFilter&leaseStatus=@Model.LeaseStatusFilter">
            <i class="fa fa-file-alt me-1"></i>
            @(Model.IsManager ? "Applications" : "My Applications")
            <span class="badge bg-dark ms-1">@Model.AppCounts["All"]</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "leases" ? "active fw-semibold" : "")"
           href="?tab=leases&appStatus=@Model.AppStatusFilter&leaseStatus=@Model.LeaseStatusFilter">
            <i class="fa fa-key me-1"></i>
            @(Model.IsManager ? "Leases" : "My Leases")
            <span class="badge bg-dark ms-1">@Model.LeaseCounts["All"]</span>
        </a>
    </li>
</ul>

<div class="tab-content border border-top-0 rounded-bottom p-3 bg-white shadow-sm">

    <!-- ══ APPLICATIONS PANEL ══════════════════════════════════════════════ -->
    <div class="@(Model.ActiveTab == "applications" ? "" : "d-none")">

        <ul class="nav nav-pills mb-3 flex-wrap gap-1">
            @foreach (var s in ApplicationsAndLeasesViewModel.AppStatuses)
            {
                bool isActive = Model.AppStatusFilter == s;
                <li class="nav-item">
                    <a class="nav-link py-1 px-3 @(isActive ? "active" : "text-dark border")"
                       href="@AppUrl(s)">@s</a>
                </li>
            }
        </ul>

        @if (appRowCount == 0)
        {
            <div class="alert alert-info mb-0">
                <i class="fa fa-info-circle me-2"></i>
                No @(Model.AppStatusFilter == "All" ? "" : Model.AppStatusFilter.ToLower() + " ")applications found.
            </div>
        }
        else
        {
            <p class="text-muted small mb-2">
                Showing <strong>@appRowCount</strong>
                @(Model.AppStatusFilter == "All" ? "" : Model.AppStatusFilter.ToLower() + " ")
                application@(appRowCount == 1 ? "" : "s")
            </p>

            @if (Model.IsManager)
            {
                @foreach (var group in Model.ApplicationGroups)
                {
                    string unitBadge = group.AvailabilityStatus == "Available" ? "success" : "secondary";
                    <div class="card mb-3 shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center bg-light">
                            <div>
                                <i class="fa fa-home me-2 text-primary"></i>
                                <strong>@group.UnitNumber</strong>
                                <span class="text-muted ms-1">— @group.PropertyName</span>
                                <span class="badge bg-@unitBadge ms-2">@group.AvailabilityStatus</span>
                            </div>
                            <span class="badge bg-dark">@group.ApplicationCount application(s)</span>
                        </div>
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">#</th>
                                        <th>Tenant</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Status</th>
                                        <th>Applied</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in group.Applications)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted small">@a.ApplicationId</td>
                                            <td>
                                                @a.TenantName
                                                @if (a.IsRenewal) { <span class="badge bg-info ms-1">Renewal</span> }
                                            </td>
                                            <td>@(a.RequestedStartDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                            <td>@(a.RequestedEndDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                            <td><span class="badge bg-@AppBadge(a.Status)">@a.Status</span></td>
                                            <td class="text-muted small">@a.CreatedAt.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@a.ApplicationId"
                                                   class="btn btn-outline-primary btn-sm">
                                                    <i class="fa fa-eye me-1"></i>View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Tenant: flat list -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Unit</th>
                                <th>Property</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th>Applied</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Applications)
                            {
                                <tr>
                                    <td class="text-muted small">@a.ApplicationId</td>
                                    <td>
                                        @a.UnitNumber
                                        @if (a.IsRenewal) { <span class="badge bg-info ms-1">Renewal</span> }
                                    </td>
                                    <td>@a.PropertyName</td>
                                    <td>@(a.RequestedStartDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                    <td>@(a.RequestedEndDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                    <td><span class="badge bg-@AppBadge(a.Status)">@a.Status</span></td>
                                    <td class="text-muted small">@a.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td class="d-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@a.ApplicationId"
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="fa fa-eye me-1"></i>View
                                        </a>
                                        @if (a.CanCancel)
                                        {
                                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                                    onclick="showCancelApp(@a.ApplicationId)"
                                                    title="Cancel this application"> 
                                                <i class="fa fa-times"></i> 
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>

    <!-- ══ LEASES PANEL ════════════════════════════════════════════════════ -->
    <div class="@(Model.ActiveTab == "leases" ? "" : "d-none")">

        <ul class="nav nav-pills mb-3 flex-wrap gap-1">
            @foreach (var s in ApplicationsAndLeasesViewModel.LeaseStatuses)
            {
                bool isActive = Model.LeaseStatusFilter == s;
                <li class="nav-item">
                    <a class="nav-link py-1 px-3 @(isActive ? "active" : "text-dark border")"
                       href="@LeaseUrl(s)">@s</a>
                </li>
            }
        </ul>

        @if (leaseRowCount == 0)
        {
            <div class="alert alert-info mb-0">
                <i class="fa fa-info-circle me-2"></i>
                No @(Model.LeaseStatusFilter == "All" ? "" : Model.LeaseStatusFilter.ToLower() + " ")leases found.
            </div>
        }
        else
        {
            <p class="text-muted small mb-2">
                Showing <strong>@leaseRowCount</strong>
                @(Model.LeaseStatusFilter == "All" ? "" : Model.LeaseStatusFilter.ToLower() + " ")
                lease@(leaseRowCount == 1 ? "" : "s")
            </p>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            @if (Model.IsManager) { <th>Tenant</th> }
                            <th>Unit</th>
                            <th>Property</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Rent / mo</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Leases)
                        {
                            bool isOverdue  = l.LeaseEndDate < DateTime.Today && l.Status == "Active";
                            string rowClass = isOverdue ? "table-warning" : "";
                            <tr class="@rowClass">
                                <td class="text-muted small">@l.LeaseId</td>
                                @if (Model.IsManager) { <td>@l.TenantName</td> }
                                <td>@l.UnitNumber</td>
                                <td>@l.PropertyName</td>
                                <td>@l.LeaseStartDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @l.LeaseEndDate.ToString("dd MMM yyyy")
                                    @if (l.TerminationDate.HasValue)
                                    {
                                        <br /><small class="text-danger"><i class="fa fa-scissors me-1"></i>Terminates: @l.TerminationDate.Value.ToString("dd MMM yyyy")</small>
                                    }
                                </td>
                                <td>BD @l.MonthlyRent.ToString("N0")</td>
                                <td>
                                    <span class="badge bg-@LeaseBadge(l.Status)">@l.Status</span>
                                    @if (l.RenewLeaseApplicationId.HasValue)
                                    {
                                        <br /><small class="text-info"><i class="fa fa-sync me-1"></i>Renewal: @(l.RenewApplicationStatus ?? "...")</small>
                                    }
                                </td>
                                <td class="d-flex gap-1 flex-wrap">
                                    <a asp-action="LeaseDetails" asp-route-id="@l.LeaseId"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="fa fa-eye me-1"></i>View
                                    </a>
                                    @if (l.Status == "PendingPayment" && !Model.IsManager)
                                    {
                                        <a asp-controller="Payments" asp-action="SelectPlan"
                                           asp-route-leaseId="@l.LeaseId"
                                           class="btn btn-warning btn-sm">
                                            <i class="fa fa-credit-card me-1"></i>Pay Now
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        function showCancelApp(applicationId) {
            document.getElementById('cancelAppId').value = applicationId;
            var modal = new bootstrap.Modal(document.getElementById('cancelAppModal'));
            modal.show();
        }
    </script>
}
