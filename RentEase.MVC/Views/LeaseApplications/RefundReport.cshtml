@model List<PropertyLeasing.API.Models.LeaseRefund>
@{
    ViewData["Title"] = "Refund Report";
    var totalRefunded = Model.Sum(r => r.RefundAmount);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-0"><i class="fa fa-undo me-2 text-danger"></i>Refund Report</h3>
        <p class="text-muted small mb-0">All lease cancellations with refund details</p>
    </div>
    <a asp-action="Index" asp-route-tab="leases" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-arrow-left me-1"></i>Back to Leases
    </a>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card text-center shadow-sm border-0">
            <div class="card-body py-3">
                <div class="text-muted small mb-1">Total Cancellations</div>
                <div class="fs-3 fw-bold text-danger">@Model.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow-sm border-0">
            <div class="card-body py-3">
                <div class="text-muted small mb-1">Total Refunds Issued</div>
                <div class="fs-3 fw-bold text-success">BD @totalRefunded.ToString("N2")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center shadow-sm border-0">
            <div class="card-body py-3">
                <div class="text-muted small mb-1">Avg. Refund</div>
                <div class="fs-3 fw-bold text-primary">
                    BD @(Model.Count > 0 ? (totalRefunded / Model.Count).ToString("N2") : "0.00")
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <i class="fa fa-check-circle fa-3x mb-3 d-block text-success"></i>
            No lease cancellations have been recorded yet.
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <i class="fa fa-table me-2 text-muted"></i>Cancellation &amp; Refund Details
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Lease #</th>
                        <th>Tenant</th>
                        <th>Unit</th>
                        <th>Property</th>
                        <th>Cancelled On</th>
                        <th class="text-center">Months Used</th>
                        <th class="text-center">Months Refunded</th>
                        <th>Total Paid</th>
                        <th>Overdue Deducted</th>
                        <th>Refund Amount</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="ps-3">
                                <a asp-action="LeaseDetails" asp-route-id="@r.LeaseId" class="fw-semibold">
                                    #@r.LeaseId
                                </a>
                            </td>
                            <td>@r.Lease.Application.User.FullName</td>
                            <td class="text-primary fw-semibold">@r.Lease.Application.Unit.UnitNumber</td>
                            <td>@r.Lease.Application.Unit.Property.Name</td>
                            <td class="text-muted small">@r.CancelledAt.ToString("dd MMM yyyy, HH:mm")</td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@r.MonthsConsumed</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-@(r.MonthsRefunded > 0 ? "success" : "light text-dark border")">
                                    @r.MonthsRefunded
                                </span>
                            </td>
                            <td>BD @r.TotalPaid.ToString("N2")</td>
                            <td>
                                @if (r.OverdueDeducted > 0)
                                {
                                    <span class="text-danger fw-semibold">BD @r.OverdueDeducted.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (r.RefundAmount > 0)
                                {
                                    <span class="text-success fw-bold">BD @r.RefundAmount.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted">No refund</span>
                                }
                            </td>
                            <td class="text-muted small">@(r.Notes ?? "—")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light fw-semibold">
                    <tr>
                        <td colspan="9" class="text-end pe-3 ps-3">Total Refunded:</td>
                        <td class="text-success fw-bold">BD @totalRefunded.ToString("N2")</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}
