@model List<PropertyLeasing.Reporting.ViewModels.ApplicationReportItem>
@{
    ViewData["Title"] = "Lease Applications Report";
    var statuses = new[] { "Pending", "Screening", "Approved", "Rejected" };

    var countApproved  = Model.Count(a => a.Status == "Approved");
    var countPending   = Model.Count(a => a.Status == "Pending");
    var countScreening = Model.Count(a => a.Status == "Screening");
    var countRejected  = Model.Count(a => a.Status == "Rejected");
    var total          = Model.Count;
}

<!-- ── KPI Cards ──────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card border-secondary text-center">
            <div class="card-body">
                <div class="stat-num text-secondary">@total</div>
                <div class="text-muted small">Total Applications</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card border-success text-center">
            <div class="card-body">
                <div class="stat-num text-success">@countApproved</div>
                <div class="text-muted small">Approved</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card border-warning text-center">
            <div class="card-body">
                <div class="stat-num text-warning">@countPending</div>
                <div class="text-muted small">Pending</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card border-danger text-center">
            <div class="card-body">
                <div class="stat-num text-danger">@countRejected</div>
                <div class="text-muted small">Rejected</div>
            </div>
        </div>
    </div>
</div>

<!-- ── Charts Row ────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <!-- Doughnut: status split -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header fw-semibold py-3">
                <i class="fa fa-chart-pie me-2 text-info"></i>Applications by Status
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div class="chart-container mb-3" style="height:240px;width:240px;">
                    <canvas id="appDoughnut"></canvas>
                </div>
                <div class="d-flex gap-2 flex-wrap justify-content-center">
                    <span class="badge bg-success">@countApproved Approved</span>
                    <span class="badge bg-warning text-dark">@countPending Pending</span>
                    <span class="badge bg-info text-dark">@countScreening Screening</span>
                    <span class="badge bg-danger">@countRejected Rejected</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Bar: counts per status -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-semibold py-3">
                <i class="fa fa-chart-bar me-2 text-primary"></i>Status Distribution
            </div>
            <div class="card-body">
                <div class="chart-container" style="height:260px;">
                    <canvas id="appBar"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Filters + Table ───────────────────────────────────────────── -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <strong class="me-1 text-muted small">Filter:</strong>
            <a asp-action="Applications" class="btn btn-sm @(ViewBag.Status == null ? "btn-dark" : "btn-outline-dark")">All (@total)</a>
            @foreach (var s in statuses)
            {
                var color = s switch { "Approved" => "success", "Rejected" => "danger", "Screening" => "info", _ => "warning" };
                var cnt   = s switch { "Approved" => countApproved, "Rejected" => countRejected, "Screening" => countScreening, _ => countPending };
                <a asp-action="Applications" asp-route-status="@s"
                   class="btn btn-sm @(ViewBag.Status == s ? $"btn-{color}" : $"btn-outline-{color}")">@s (@cnt)</a>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header fw-semibold py-3">
        <i class="fa fa-file-alt me-2"></i> @Model.Count application(s)
        @if (ViewBag.Status != null) { <span class="badge bg-secondary ms-2">@ViewBag.Status</span> }
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Tenant</th>
                    <th>Unit</th>
                    <th>Property</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th>Applied</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var badgeColor = a.Status switch
                    {
                        "Approved"  => "success",
                        "Rejected"  => "danger",
                        "Screening" => "info",
                        _           => "warning"
                    };
                    <tr>
                        <td class="text-muted small">@a.ApplicationId</td>
                        <td class="fw-semibold">@a.TenantName</td>
                        <td>@a.UnitNumber</td>
                        <td>@a.PropertyName</td>
                        <td>@(a.RequestedStartDate?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td>@(a.RequestedEndDate?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td><span class="badge bg-@badgeColor">@a.Status</span></td>
                        <td class="text-muted small">@a.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
Chart.defaults.font.family = "'Segoe UI', system-ui, sans-serif";
Chart.defaults.plugins.legend.labels.usePointStyle = true;

new Chart(document.getElementById('appDoughnut'), {
    type: 'doughnut',
    data: {
        labels: ['Approved', 'Pending', 'Screening', 'Rejected'],
        datasets: [{
            data: [@countApproved, @countPending, @countScreening, @countRejected],
            backgroundColor: ['#198754', '#ffc107', '#0dcaf0', '#dc3545'],
            borderWidth: 2, borderColor: '#fff', hoverOffset: 10
        }]
    },
    options: {
        cutout: '68%', responsive: true, maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom' } }
    }
});

new Chart(document.getElementById('appBar'), {
    type: 'bar',
    data: {
        labels: ['Approved', 'Pending', 'Screening', 'Rejected'],
        datasets: [{
            label: 'Applications',
            data: [@countApproved, @countPending, @countScreening, @countRejected],
            backgroundColor: ['#198754', '#ffc107', '#0dcaf0', '#dc3545'],
            borderRadius: 6
        }]
    },
    options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
            x: { grid: { display: false } },
            y: { beginAtZero: true, ticks: { stepSize: 1 } }
        }
    }
});
</script>
}
