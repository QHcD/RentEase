@* ── Applications.cshtml ── *@
@model List<PropertyLeasing.Reporting.ViewModels.ApplicationReportItem>
@{
    ViewData["Title"] = "Lease Applications Report";
    var statuses = new[] { "Pending", "Screening", "Approved", "Rejected" };
}

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <strong class="me-2">Filter:</strong>
            <a asp-action="Applications" class="btn btn-sm @(ViewBag.Status == null ? "btn-dark" : "btn-outline-dark")">All</a>
            @foreach (var s in statuses)
            {
                var color = s switch { "Approved" => "success", "Rejected" => "danger", "Screening" => "info", _ => "warning" };
                <a asp-action="Applications" asp-route-status="@s"
                   class="btn btn-sm @(ViewBag.Status == s ? $"btn-{color}" : $"btn-outline-{color}")">@s</a>
            }
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header fw-bold">
        <i class="fa fa-file-alt me-1"></i> @Model.Count application(s)
        @if (ViewBag.Status != null) { <span class="badge bg-secondary ms-2">@ViewBag.Status</span> }
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Tenant</th>
                    <th>Unit</th>
                    <th>Property</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th>Applied</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var badgeColor = a.Status switch
                    {
                        "Approved"  => "success",
                        "Rejected"  => "danger",
                        "Screening" => "info",
                        _           => "warning"
                    };
                    <tr>
                        <td class="text-muted small">@a.ApplicationId</td>
                        <td>@a.TenantName</td>
                        <td>@a.UnitNumber</td>
                        <td>@a.PropertyName</td>
                        <td>@(a.RequestedStartDate?.ToString("dd MMM yyyy") ?? "-")</td>
                        <td>@(a.RequestedEndDate?.ToString("dd MMM yyyy") ?? "-")</td>
                        <td><span class="badge bg-@badgeColor">@a.Status</span></td>
                        <td>@a.CreatedAt.ToString("dd MMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
