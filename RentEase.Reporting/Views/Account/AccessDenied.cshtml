@{
    ViewData["Title"] = "Access denied";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="fa fa-lock me-2"></i>Access denied</h4>
            </div>
            <div class="card-body text-center py-4">
                <p class="mb-3">You do not have permission to use this area. Only <strong>property managers</strong> can open the reporting portal.</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-dark">
                    <i class="fa fa-sign-in-alt me-1"></i> Back to login
                </a>
            </div>
        </div>
    </div>
</div>
