<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RentEase Reporting</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    @{
        var navCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
        var navAct  = ViewContext.RouteData.Values["action"]?.ToString();
        string Lnk(string controller, string? action = null) =>
            navCtrl == controller && (action == null || navAct == action)
                ? "nav-link active"
                : "nav-link";
        string RepLnk(string action) =>
            navCtrl == "Reports" && navAct == action
                ? "nav-link active"
                : "nav-link";
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom border-body">
            <div class="container">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="navbar-brand fw-bold" asp-controller="Reports" asp-action="Occupancy">
                        <i class="fa fa-building me-1"></i> RentEase
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#reportingNavMenu" aria-controls="reportingNavMenu" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="reportingNavMenu">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="@RepLnk("Occupancy")" asp-controller="Reports" asp-action="Occupancy">
                                    <i class="fa fa-building me-1"></i>Occupancy
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@RepLnk("Maintenance")" asp-controller="Reports" asp-action="Maintenance">
                                    <i class="fa fa-wrench me-1"></i>Maintenance
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@RepLnk("Payments")" asp-controller="Reports" asp-action="Payments">
                                    <i class="fa fa-credit-card me-1"></i>Payments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@RepLnk("Applications")" asp-controller="Reports" asp-action="Applications">
                                    <i class="fa fa-file-contract me-1"></i>Applications
                                </a>
                            </li>
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa fa-user me-1"></i>@(User.FindFirst("FullName")?.Value ?? User.Identity!.Name)
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <span class="dropdown-item-text small text-muted">Reporting portal</span>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fa fa-sign-out-alt me-1"></i>Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="navbar-brand fw-bold" asp-controller="Account" asp-action="Login">
                        <i class="fa fa-building me-1"></i> RentEase
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#reportingNavGuest">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="reportingNavGuest">
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="@Lnk("Account", "Login")" asp-controller="Account" asp-action="Login">
                                    <i class="fa fa-sign-in-alt me-1"></i>Login
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        @if (ViewData["HidePageTitle"] as bool? != true && !string.IsNullOrEmpty(ViewData["Title"]?.ToString()))
        {
            <h2 class="mb-4">@ViewData["Title"]</h2>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - RentEase Leasing &amp; Maintenance Platform — Reporting
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
