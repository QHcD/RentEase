@model PropertyLeasing.MVC.ViewModels.DocumentViewerViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
    <style>
        html, body { margin: 0; height: 100%; overflow: hidden; }
        iframe { border: 0; width: 100%; height: 100%; }
    </style>
</head>
<body>
    <iframe src="@Url.Action("ViewDocumentContent", new { id = Model.DocumentId })"
            title="@Model.Title"></iframe>
</body>
</html>
