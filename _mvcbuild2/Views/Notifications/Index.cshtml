@model List<PropertyLeasing.MVC.ViewModels.NotificationViewModel>
@{
    ViewData["Title"] = "Notifications";
    var unreadCount = Model.Count(n => n.IsUnread);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>
        <i class="fa fa-bell me-2"></i>Notifications
        @if (unreadCount > 0)
        {
            <span class="badge bg-danger">@unreadCount</span>
        }
    </h2>
    @if (unreadCount > 0)
    {
        <form asp-action="MarkAllRead" method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-secondary btn-sm">
                <i class="fa fa-check-double me-1"></i> Mark all read
            </button>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info"><i class="fa fa-info-circle me-2"></i>No notifications yet.</div>
}
else
{
    <div class="list-group">
        @foreach (var n in Model)
        {
            var typeIcon = n.NotificationType switch
            {
                "LeaseUpdate"       => "fa-file-alt text-success",
                "MaintenanceUpdate" => "fa-wrench text-warning",
                "PaymentReminder"   => "fa-money-bill text-danger",
                _                   => "fa-bell text-info"
            };
            <div class="list-group-item list-group-item-action @(n.IsUnread ? "list-group-item-light border-start border-primary border-3" : "")">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex gap-3 align-items-start">
                        <i class="fa @typeIcon mt-1"></i>
                        <div>
                            <div>@n.Message</div>
                            <small class="text-muted">@n.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (n.IsUnread)
                        {
                            <span class="badge bg-primary">New</span>
                            <form asp-action="MarkRead" asp-route-id="@n.NotificationId" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-secondary btn-sm">
                                    <i class="fa fa-check"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
