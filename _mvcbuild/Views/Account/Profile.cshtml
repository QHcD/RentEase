@model PropertyLeasing.MVC.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="fa fa-user me-2"></i>My Profile</h4>
                <span class="badge bg-info">@Model.Role</span>
            </div>
            <div class="card-body">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <h6 class="text-muted mb-3">Personal Information</h6>
                <dl class="row mb-4">
                    <dt class="col-sm-4">Full Name</dt>
                    <dd class="col-sm-8">@Model.FullName</dd>

                    <dt class="col-sm-4">Username</dt>
                    <dd class="col-sm-8">@Model.Username</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Phone</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>
                </dl>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="ProfileEdit" class="btn btn-primary">
                        <i class="fa fa-pen me-1"></i>Edit Profile
                    </a>
                    <a asp-action="ChangePassword" class="btn btn-outline-secondary">
                        <i class="fa fa-key me-1"></i>Change Password
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
