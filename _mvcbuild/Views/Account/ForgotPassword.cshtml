@model PropertyLeasing.MVC.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0"><i class="fa fa-key me-2"></i>Forgot Password</h4>
            </div>
            <div class="card-body">
                <p class="text-muted mb-3">
                    Enter the email address associated with your account and we'll send you a 6-digit reset code.
                </p>

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="your@email.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-dark w-100">
                        <i class="fa fa-paper-plane me-1"></i> Send Reset Code
                    </button>
                </form>
            </div>
            <div class="card-footer text-center text-muted small">
                Remembered your password? <a asp-action="Login">Back to Login</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
