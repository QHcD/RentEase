@model PropertyLeasing.API.Models.LeaseRefund
@{
    ViewData["Title"] = $"Refund Receipt — Lease #{Model.LeaseId}";
    var tenant   = Model.Lease.Application.User;
    var unit     = Model.Lease.Application.Unit;
    var property = unit.Property;
}

<!-- Print / Download button (hidden on print) -->
<div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="fa fa-arrow-left me-1"></i>Back to Payments
    </a>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-outline-secondary btn-sm">
            <i class="fa fa-print me-1"></i>Print
        </button>
        <button onclick="downloadReceipt()" class="btn btn-danger btn-sm">
            <i class="fa fa-download me-1"></i>Download PDF
        </button>
    </div>
</div>

<!-- ── Receipt Card ─────────────────────────────────────────────────── -->
<div id="refundReceiptDoc" class="card shadow border-0 mx-auto" style="max-width:700px;">

    <!-- Header -->
    <div class="card-header text-white text-center py-4"
         style="background:linear-gradient(135deg,#b71c1c,#e53935);">
        <div class="fs-4 fw-bold"><i class="fa fa-building me-2"></i>RentEase</div>
        <div class="small opacity-75">Leasing & Maintenance Platform</div>
        <div class="mt-2 fs-5 fw-semibold">
            <i class="fa fa-undo me-2"></i>Refund Receipt
        </div>
    </div>

    <div class="card-body px-4 py-4">

        <!-- Receipt No & Date -->
        <div class="d-flex justify-content-between mb-4">
            <div>
                <div class="text-muted small">Receipt No.</div>
                <div class="fw-bold">RFD-@Model.RefundId.ToString("D6")</div>
            </div>
            <div class="text-end">
                <div class="text-muted small">Cancelled On</div>
                <div class="fw-bold">@Model.CancelledAt.ToString("dd MMM yyyy, HH:mm")</div>
            </div>
        </div>

        <hr />

        <!-- Tenant Info -->
        <div class="row mb-4">
            <div class="col-6">
                <div class="text-muted small mb-1">Tenant</div>
                <div class="fw-semibold">@tenant.FullName</div>
                <div class="text-muted small">@tenant.Email</div>
                @if (!string.IsNullOrEmpty(tenant.Phone))
                {
                    <div class="text-muted small">@tenant.Phone</div>
                }
            </div>
            <div class="col-6 text-end">
                <div class="text-muted small mb-1">Property / Unit</div>
                <div class="fw-semibold">@unit.UnitNumber</div>
                <div class="text-muted small">@property.Name</div>
                <div class="text-muted small">@property.Address</div>
            </div>
        </div>

        <!-- Lease Info -->
        <div class="p-3 bg-light rounded mb-4">
            <div class="row g-2 text-center">
                <div class="col-4">
                    <div class="text-muted small">Lease #</div>
                    <div class="fw-semibold">@Model.LeaseId</div>
                </div>
                <div class="col-4">
                    <div class="text-muted small">Lease Start</div>
                    <div class="fw-semibold">@Model.Lease.LeaseStartDate.ToString("dd MMM yyyy")</div>
                </div>
                <div class="col-4">
                    <div class="text-muted small">Lease End</div>
                    <div class="fw-semibold">@Model.Lease.LeaseEndDate.ToString("dd MMM yyyy")</div>
                </div>
            </div>
        </div>

        <!-- Refund Breakdown -->
        <table class="table table-bordered mb-4">
            <thead class="table-light">
                <tr>
                    <th>Description</th>
                    <th class="text-end">Amount (BD)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Total paid (all installments)</td>
                    <td class="text-end">@Model.TotalPaid.ToString("N3")</td>
                </tr>
                <tr class="table-danger">
                    <td>
                        Months consumed &amp; forfeited
                        <span class="text-muted small">(@Model.MonthsConsumed month(s) × BD @Model.Lease.MonthlyRent.ToString("N3"))</span>
                    </td>
                    <td class="text-end text-danger">
                        − @(Math.Min(Model.MonthsConsumed * Model.Lease.MonthlyRent, Model.TotalPaid).ToString("N3"))
                    </td>
                </tr>
                @if (Model.OverdueDeducted > 0)
                {
                    <tr class="table-warning">
                        <td>Outstanding balance deducted</td>
                        <td class="text-end text-danger">− @Model.OverdueDeducted.ToString("N3")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="@(Model.RefundAmount > 0 ? "table-success" : "table-secondary") fw-bold">
                    <td class="fs-6">
                        <i class="fa fa-@(Model.RefundAmount > 0 ? "money-bill-wave text-success" : "minus-circle text-secondary") me-1"></i>
                        Refund Amount
                        <span class="fw-normal text-muted small ms-1">(@Model.MonthsRefunded month(s) refunded)</span>
                    </td>
                    <td class="text-end fs-5 @(Model.RefundAmount > 0 ? "text-success" : "text-secondary")">
                        BD @Model.RefundAmount.ToString("N3")
                    </td>
                </tr>
            </tfoot>
        </table>

        @if (Model.RefundAmount > 0)
        {
            <!-- Refund Notice -->
            <div class="alert alert-success border-0 d-flex align-items-start gap-3">
                <i class="fa fa-credit-card fa-2x text-success mt-1 flex-shrink-0"></i>
                <div>
                    <div class="fw-semibold">Refund Processing</div>
                    <div class="small">
                        A refund of <strong>BD @Model.RefundAmount.ToString("N3")</strong> will be
                        returned to the tenant's bank card within <strong>5–7 business days</strong>
                        from the cancellation date (@Model.CancelledAt.ToString("dd MMM yyyy")).
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-secondary border-0">
                <i class="fa fa-info-circle me-2"></i>
                No refund is due — all paid months have been consumed.
            </div>
        }

        <!-- Notes -->
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="text-muted small mt-2">
                <i class="fa fa-sticky-note me-1"></i>@Model.Notes
            </div>
        }
    </div>

    <!-- Footer -->
    <div class="card-footer text-center text-muted small py-3 bg-light">
        <i class="fa fa-shield-alt me-1"></i>
        This is an official refund receipt issued by RentEase. &copy; @DateTime.Now.Year RentEase Leasing Platform.
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    function downloadReceipt() {
        var el = document.getElementById('refundReceiptDoc');
        html2pdf().set({
            margin:     [10, 10, 10, 10],
            filename:   'Refund-Receipt-RFD-@Model.RefundId.ToString("D6")',
            image:      { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2 },
            jsPDF:      { unit: 'mm', format: 'a4', orientation: 'portrait' }
        }).from(el).save();
    }
</script>
}
